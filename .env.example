# Obligatoire : clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Recommandé : clé YouTube Data API v3 (permet de filtrer les vidéos Creative Commons)
# Sans clé, la recherche passe par yt-dlp (pas de filtre de licence).
YOUTUBE_API_KEY=

# Modèle Claude utilisé pour choisir les moments
CLAUDE_MODEL=claude-sonnet-5-5

# Taille du modèle Whisper si pas de sous-titres YouTube (tiny, base, small, medium, large-v3)
WHISPER_MODEL=small
